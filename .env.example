# 中文情感分析系统 - 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# API服务器配置
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=True

# 数据目录配置
DATA_CACHE_DIR=./data_files
MODELS_DIR=./models

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/sentiment_analysis.log

# 模型配置
DEFAULT_MODEL=textcnn_chinese
MODEL_LANGUAGE=chinese

# Hugging Face配置（用于BERT模型，可选）
# HUGGINGFACE_TOKEN=your_token_here

# CUDA配置（GPU加速，可选）
# CUDA_VISIBLE_DEVICES=0